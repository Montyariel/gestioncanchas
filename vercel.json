{
  "version": 2,
  "builds": [
    {
      "src": "api/serve-app.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/serve-app.js"
    },
    {
      "source": "/create-preference",
      "destination": "/api/serve-app.js"
    },
    {
      "source": "/((?!api/|create-preference).*\\..*)",
      "destination": "/app/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app/index.html"
    }
  ]
}
