# ===== SUPABASE =====
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
# Necesario para Nico Agent server-side (sacalo de Supabase > Settings > API > service_role key)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ===== MERCADO PAGO =====
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-token-mp
MERCADOPAGO_ACCESS_TOKEN_SERVE=APP_USR-tu-token-mp-serve

# ===== NICO AGENT =====
# API key para que cron-job.org pueda llamar a los endpoints del agente
# Generá una clave random (ej: openssl rand -hex 32)
AGENT_API_KEY=tu-agent-api-key

# ===== APP =====
APP_URL=http://localhost:4000
PORT=4000
